# Flask and browser policy
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_REQUEST_BYTES=262144
TRUST_PROXY_HEADERS=false

# Ephemeral backend connection sessions
CONNECTION_SESSION_TTL_SECONDS=1800
MAX_CONNECTION_SESSIONS=100

# MySQL safety limits applied to customer-created sessions
DB_CONNECT_TIMEOUT_SECONDS=5
DB_READ_TIMEOUT_SECONDS=30
DB_WRITE_TIMEOUT_SECONDS=10
STATEMENT_TIMEOUT_MS=10000
MYSQL_SSL_CA=

# Runtime benchmark sampling
RUNTIME_WARMUPS=1
RUNTIME_SAMPLES=3

# Schema response limits
SCHEMA_MAX_TABLES=500
SCHEMA_MAX_COLUMNS=10000

# Rate limiting. Use Redis in multi-instance deployments.
RATELIMIT_DEFAULT=120 per minute
RATELIMIT_STORAGE_URI=memory://

# Optional frontend override. Leave unset for Vite proxy or Docker/Nginx.
# VITE_API_URL=https://sqlrefine.example.com/api

# Disposable MySQL profile used only by docker compose --profile integration
MYSQL_DEMO_ROOT_PASSWORD=local-root-only
MYSQL_DEMO_PASSWORD=local-reader-only

